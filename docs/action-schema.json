{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JarvisOutput",
  "type": "object",
  "required": ["response_text", "actions", "confidence"],
  "properties": {
    "response_text": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["connector", "operation", "payload"],
        "properties": {
          "connector": { "enum": ["shopify", "wordpress", "greenfield"] },
          "operation": { "type": "string" },
          "payload": { "type": "object" }
        }
      }
    }
  }
}

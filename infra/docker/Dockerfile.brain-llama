FROM python:3.11-slim
WORKDIR /app
COPY packages/brain/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY packages/brain ./packages/brain
ENV PYTHONPATH=/app/packages/brain
ENV BRAIN_BACKEND=mock
WORKDIR /app/packages/brain
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "jarvis.inference.server:app", "--host", "0.0.0.0", "--port", "8000"]
